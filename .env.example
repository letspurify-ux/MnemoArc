# Copy to .env and fill locally; never commit credentials.
OPENROUTER_API_KEY=
MNEMOARC_MODEL=qwen/qwen3.8-27b
MNEMOARC_MODEL_CONTEXT=1000000
MNEMOARC_ENABLE_THINKING=false
MNEMOARC_MAX_CONCURRENT_SESSIONS=4
# Optional Oracle password for a manually enabled database query.
# MNEMOARC_DB_PASSWORD=
# Saved config.toml takes precedence over MNEMOARC_* values.
